def get_node_id(coord):
    '''
    Creates id's for each node(labels)
    '''
    if coord not in coord_to_id:
        coord_to_id[coord] = len(coord_to_id)
    return coord_to_id[coord]


def add_tile(x, y):
    '''
    Adds a tile
    '''
    bl = (x, y)
    br = (x + 1, y)
    tl = (x, y + 1)
    tr = (x + 1, y + 1)

    bl_id = get_node_id(bl)
    br_id = get_node_id(br)
    tl_id = get_node_id(tl)
    tr_id = get_node_id(tr)

    tiles.append((bl_id, br_id, tr_id, tl_id))
    tile_coords.append((x, y))

    directed_edges = [
        (bl_id, br_id),
        (bl_id, tl_id),
        (br_id, tr_id),
        (tl_id, tr_id),
    ]

    for u, v in directed_edges:
        coord_u = [coord for coord, uid in coord_to_id.items() if uid == u][0]
        coord_v = [coord for coord, uid in coord_to_id.items() if uid == v][0]
        weight = 1 if coord_u[0] != coord_v[0] else 2
        edges.append((u, v, weight))


def is_valid(x, y):
    '''
    Checks to see if a tile is within the grid dimensions and hasn't been added yet
    '''
    return 0 <= x < GRID_WIDTH - 1 and 0 <= y < GRID_HEIGHT - 1 and (x, y) not in used_tiles


def find_structured_iso_vertices(return_nodes=False, local_tiles=None):
    """
    Finds vertices that participate in exactly 4 tiles with the following configuration:
        (v,a,b,c), (e,v,c,d), (f,g,v,e), (g,h,a,v)
    where each 4-tuple is a tile (bl, br, tr, tl)
    and node v appears once in each tile.

    If return_nodes is True, returns (count, list_of_nodes)
    """
    if local_tiles is None:
        local_tiles = tiles

    # Step 1: Map nodes to the tiles and positions they appear in
    node_to_tile_pos = defaultdict(list)  # node → list of (tile_index, position)

    for tile_index, tile in enumerate(local_tiles):
        for pos, node in enumerate(tile):
            node_to_tile_pos[node].append((tile_index, pos))

    # Step 2: Find nodes with exactly 4 appearances (once in 4 different tiles)
    valid_nodes = []
    for node, occurrences in node_to_tile_pos.items():
        if len(occurrences) != 4:
            continue

        tile_indices = [t[0] for t in occurrences]
        if len(set(tile_indices)) != 4:
            continue

        # Extract the 4 tiles
        candidate_tiles = [local_tiles[i] for i in tile_indices]

        # Try all permutations of the 4 tiles to find the right configuration
        from itertools import permutations

        for perm in permutations(candidate_tiles):
            t1, t2, t3, t4 = perm

            # Find where `node` is in each tile
            try:
                v1 = t1.index(node)
                v2 = t2.index(node)
                v3 = t3.index(node)
                v4 = t4.index(node)
            except ValueError:
                continue

            # Extract values based on pattern (v,a,b,c) etc.
            # Pattern:
            #  t1: (v, a, b, c)
            #  t2: (e, v, c, d)
            #  t3: (f, g, v, e)
            #  t4: (g, h, a, v)

            try:
                # Map tiles to variables based on assumption that `v` is at pos 0 in t1
                v, a, b, c = rotate_tile_to_match_v_first(t1, node)
                e2, v, c2, d = rotate_tile_to_match_v_second(t2, node)
                f, g, v, e3 = rotate_tile_to_match_v_third(t3, node)
                g2, h, a2, v = rotate_tile_to_match_v_fourth(t4, node)
            except Exception:
                continue

            # Now check structural constraints:
            if a == a2 and c == c2 and e2 == e3 and g == g2:
                valid_nodes.append(node)
                break  # stop checking permutations

    if return_nodes:
        return len(valid_nodes), valid_nodes
    else:
        return len(valid_nodes)

def rotate_tile_to_match_v_first(tile, v):
    for i in range(4):
        rotated = tile[i:] + tile[:i]
        if rotated[0] == v:
            return rotated
    raise ValueError("v not found in tile")

def rotate_tile_to_match_v_second(tile, v):
    for i in range(4):
        rotated = tile[i:] + tile[:i]
        if rotated[1] == v:
            return rotated
    raise ValueError("v not in position 1")

def rotate_tile_to_match_v_third(tile, v):
    for i in range(4):
        rotated = tile[i:] + tile[:i]
        if rotated[2] == v:
            return rotated
    raise ValueError("v not in position 2")

def rotate_tile_to_match_v_fourth(tile, v):
    for i in range(4):
        rotated = tile[i:] + tile[:i]
        if rotated[3] == v:
            return rotated
    raise ValueError("v not in position 3")


def r(N,tile_list=None):
    '''
    Reward function (0 if no iso vertices, 1 if all iso (torus))
    '''
    count, nodes = find_structured_iso_vertices(return_nodes=True,local_tiles=tile_list)
    return count / N


def find_boundary_edges(N, adj_csr, tile_list):
    '''
    Finds the edges in the boundary (connected to at most one tile)
    '''
    edge_counter = Counter()
    for tile in tile_list:
        bl, br, tr, tl = tile
        directed_edges = [
            (bl, br),
            (bl, tl),
            (br, tr),
            (tl, tr),
        ]
        for edge in directed_edges:
            edge_counter[edge] += 1

    boundary_edges = []
    for (u, v), count in edge_counter.items():
        if count == 1:
            weight = adj_csr[u, v]
            weight = weight if np.isscalar(weight) else weight.toarray()[0, 0]
            boundary_edges.append((u, v, float(weight)))
    return boundary_edges


def pair(boundary, do_vert=False, do_horizon=False, max_retries=100):
    '''
    Pairs boundary edges (horizontal or vertical).
    Retries random orderings until no same-tile-only leftovers remain.
    '''
    vert = [e for e in boundary if e[2] == 2]
    horizon = [e for e in boundary if e[2] == 1]
    edge_list = vert if do_vert else horizon

    # Build edge-to-tile map
    edge_to_tiles = defaultdict(set)
    for idx, tile in enumerate(tiles):
        bl, br, tr, tl = tile
        tile_edges = [
            (bl, br),
            (bl, tl),
            (br, tr),
            (tl, tr),
        ]
        for edge in tile_edges:
            edge_to_tiles[tuple(sorted(edge))].add(idx)

    def in_same_tile(e1, e2):
        t1 = edge_to_tiles.get(tuple(sorted((e1[0], e1[1]))), set())
        t2 = edge_to_tiles.get(tuple(sorted((e2[0], e2[1]))), set())
        return bool(t1 & t2)

    def try_pair(edges):
        pairs = []
        used = set()
        for i in range(len(edges)):
            if i in used:
                continue
            u1, v1, _ = edges[i]
            for j in range(i + 1, len(edges)):
                if j in used:
                    continue
                u2, v2, _ = edges[j]
                if len({u1, v1} & {u2, v2}) == 0 and not in_same_tile((u1, v1), (u2, v2)):
                    pairs.append((edges[i], edges[j]))
                    used.update([i, j])
                    break
        leftover = [edges[i] for i in range(len(edges)) if i not in used]
        return pairs, leftover

    # Try multiple random orderings to get a clean pairing
    for attempt in range(max_retries):
        random.shuffle(edge_list)
        pairs, leftover = try_pair(edge_list)
        if len(leftover) < 2:
            return pairs
    print("[WARNING] Max retries reached. Returning best-effort pairs.")
    return pairs  # May leave one pair unpaired in worst case


def glue(edge_pairs):
    '''
    Main gluing function
    - Maps existing paired nodes to a new id
    - Updates list of edges with new mapped nodes
    - Updates list of tiles with new mapped nodes
    - Resolves new mappings for more than one gluing call
    '''
    global merge_map, next_node_id

    if not merge_map:
        existing_nodes = set()
        for u, v, _ in edges:
            existing_nodes.update([u, v])
        next_node_id = max(existing_nodes) + 1

    for (u1, v1, _), (u2, v2, _) in edge_pairs:
        ru1 = resolve_mapping(u1)
        ru2 = resolve_mapping(u2)
        if ru1 in merge_map:
            merged_u = merge_map[ru1]
        elif ru2 in merge_map:
            merged_u = merge_map[ru2]
        else:
            merged_u = next_node_id
            next_node_id += 1

        rv1 = resolve_mapping(v1)
        rv2 = resolve_mapping(v2)
        if rv1 in merge_map:
            merged_v = merge_map[rv1]
        elif rv2 in merge_map:
            merged_v = merge_map[rv2]
        else:
            merged_v = next_node_id
            next_node_id += 1

        for u in [u1, u2]:
            merge_map[u] = merged_u
        for v in [v1, v2]:
            merge_map[v] = merged_v

    # ✅ Normalize the entire merge_map
    for node in list(merge_map.keys()):
        resolve_mapping(node)

    # Rebuild edge list using final merged IDs
    new_edges = []
    for u, v, w in edges:
        new_u = resolve_mapping(u)
        new_v = resolve_mapping(v)
        if new_u != new_v:
            new_edges.append((new_u, new_v, w))
    new_edges = list(set(new_edges))

    # Rebuild tile list
    new_tiles = []
    for tile in tiles:
        new_tile = tuple(resolve_mapping(n) for n in tile)
        new_tiles.append(new_tile)

    return new_edges, new_tiles

def create_graph():
    '''
    Creates the graph
    '''
    while len(used_tiles) < NUM_TILES and frontier:
        fx, fy = random.choice(list(frontier))
        frontier.remove((fx, fy))
        if not is_valid(fx, fy):
            continue
        used_tiles.add((fx, fy))
        add_tile(fx, fy)
        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
            nx_, ny = fx + dx, fy + dy
            if is_valid(nx_, ny):
                frontier.add((nx_, ny))


def count_unique_nodes(edge_list=None, tile_list=None):
    '''
    Counts nodes (not sure if I need this but it works and I'll fix later)
    '''
    unique_nodes = set()
    if edge_list:
        for u, v, _ in edge_list:
            unique_nodes.update([u, v])
    if tile_list:
        for tile in tile_list:
            unique_nodes.update(tile)
    return len(unique_nodes)

def count_final_nodes(edge_list):
    """
    Counts unique, resolved node IDs after gluing.
    Ensures transitive merges are accounted for.
    """
    resolved_nodes = set()
    for u, v, _ in edge_list:
        resolved_nodes.add(resolve_mapping(u))
        resolved_nodes.add(resolve_mapping(v))
    return len(resolved_nodes)

def get_grid_positions():
    '''
    Fixes grid (makes it rectangular before gluing)
    '''
    return {node_id: coord for coord, node_id in coord_to_id.items()}


def draw_graph(edge_list, ax, title, boundary_edges=set(), pos=None):
    '''
    Draws graph
    '''
    G = nx.DiGraph()
    for u, v, w in edge_list:
        G.add_edge(u, v, weight=w)
    edge_colors = ["green" if (u, v) in boundary_edges else ("blue" if G[u][v]['weight'] == 1 else "red") for u, v in G.edges()]
    nx.draw(G, pos, ax=ax, with_labels=True, edge_color=edge_colors,
            arrows=True, node_size=500, font_size=10, width=2, arrowsize=20)
    ax.set_title(title)

def resolve_mapping(node):
    """
    Resolves the final node ID after following the merge chain recursively.
    Applies path compression to flatten the mapping.
    """
    path = []
    while node in merge_map and merge_map[node] != node:
        path.append(node)
        node = merge_map[node]
    final = node
    for n in path:
        merge_map[n] = final
    return final


def generate_graph(num_graphs=1, min_tiles=10, max_tiles=50):
    """
    Generates graphs and merges their horizontal and vertical edges.
    Returns a list of graph dicts with merged edges and tiles.
    """
    graphs = []
    start_time = time.time()
    for _ in range(num_graphs):
        # Reset globals
        global coord_to_id, edges, tiles, tile_coords, used_tiles, merge_map, next_node_id, frontier

        coord_to_id = {}
        edges = []
        tiles = []
        tile_coords = []
        used_tiles = set()
        merge_map = {}
        next_node_id = 0

        start_x = (GRID_WIDTH - 1) // 2
        start_y = (GRID_HEIGHT - 1) // 2
        used_tiles.add((start_x, start_y))
        frontier = set([
            (start_x + 1, start_y),
            (start_x - 1, start_y),
            (start_x, start_y + 1),
            (start_x, start_y - 1)
        ])

        #Generate random amount of tiles
        num_tiles = random.randint(min_tiles, max_tiles)
        max_attempts = 10 * num_tiles  # Arbitrary cap to prevent infinite loop
        attempts = 0

        while len(used_tiles) < num_tiles and frontier and attempts < max_attempts:
            fx, fy = random.choice(list(frontier))
            frontier.remove((fx, fy))
            if not is_valid(fx, fy):
                attempts += 1
                continue
            used_tiles.add((fx, fy))
            add_tile(fx, fy)
            for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                nx_, ny = fx + dx, fy + dy
                if is_valid(nx_, ny):
                    frontier.add((nx_, ny))
            attempts += 1

        if (start_x, start_y) not in used_tiles:
            add_tile(start_x, start_y)
            
        # Initial reward (before merging)
        num_nodes = count_unique_nodes(edge_list=edges)
        reward_before = r(num_nodes)
        
        # Initial counts and adjacency
        num_nodes = count_unique_nodes(edge_list=edges)
        adj = lil_matrix((num_nodes, num_nodes), dtype=np.float32)
        for u, v, w in edges:
            adj[u, v] = w
        adj_csr = adj.tocsr()

        # --- Horizontal merge ---
        boundary = find_boundary_edges(num_nodes, adj_csr, tiles)
        pairs = pair(boundary, do_horizon=True)
        merged_edges, merged_tiles = glue(pairs)
        tiles[:] = merged_tiles  # Update global tiles

        # Reward after horizontal merge
        num_nodes_horiz = count_unique_nodes(edge_list=merged_edges)
        reward_after_horiz = r(num_nodes_horiz)

        # Rebuild adjacency after horizontal merge
        max_node_id = max(max(u, v) for u, v, _ in merged_edges)
        new_adj = lil_matrix((max_node_id + 1, max_node_id + 1), dtype=np.float32)
        for u, v, w in merged_edges:
            new_adj[u, v] = w
        new_adj_csr = new_adj.tocsr()

        # --- Vertical merge ---
        new_boundary = find_boundary_edges(count_unique_nodes(edge_list=merged_edges), new_adj_csr, tiles)
        new_pairs = pair(new_boundary, do_vert=True)
        merged_edges, merged_tiles = glue(new_pairs)
        tiles[:] = merged_tiles

        # Reward after vertical merge
        num_nodes_vert = count_unique_nodes(edge_list=merged_edges)
        reward_after_vert = r(num_nodes_vert)
        
        # Store merged graph data
        graph_data = {
            'tiles': tiles.copy(),
            'edges': merged_edges.copy(),
            'used_tiles': used_tiles.copy(),
            'coord_to_id': coord_to_id.copy(),
            'merge_map': merge_map.copy(),
            'reward_before': reward_before,
            'reward_after_horizontal': reward_after_horiz,
            'reward_after_vertical': reward_after_vert,
        }
        graphs.append(graph_data)
        elapsed = time.time() - start_time
        start_time = time.time()

    return graphs

def generate_single_sample(_):
    graphs = generate_graph(num_graphs=1, min_tiles=10, max_tiles=50)
    graph = graphs[0]

    # Convert tiles to strings
    tile_strings = ["_".join(map(str, tile)) for tile in graph['tiles']]
    text_for_tokenizer = " ".join(tile_strings)

    # Choose a reward value to store (maybe reward_after_vertical)
    reward = graph['reward_after_vertical']

    return {"text": text_for_tokenizer, "reward": reward}


