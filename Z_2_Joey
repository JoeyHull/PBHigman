def tiles_to_edge_list(tile_list):
    """
    Given a list of 4-tuples (tiles), returns a deduplicated list of directed edges with weights.
    - Horizontal edges (left→right) have weight 1.
    - Vertical edges (bottom→top) have weight 2.

    Args:
        tile_list (list of tuple): List of 4-tuples representing tiles (bl, br, tr, tl).

    Returns:
        edge_list (list of tuple): List of edges (u, v, weight).
    """
    edge_set = set()
    for tile in tile_list:
        bl, br, tr, tl = tile

        # Define edges
        edges = [
            (bl, br, 1),  # horizontal bottom
            (bl, tl, 2),  # vertical left
            (br, tr, 2),  # vertical right
            (tl, tr, 1),  # horizontal top
        ]

        for edge in edges:
            edge_set.add(edge)  # avoid duplicates

    return list(edge_set)

def generate_pos_from_edges(edges):
    G = nx.DiGraph()
    for u, v, w in edges:
        G.add_edge(u, v, weight=w)
    return nx.spring_layout(G, seed=42)

