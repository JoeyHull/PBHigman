def decode_tile_string(tile_string):
    """
    Converts a space-separated string of tiles like "12_13_14_15 16_17_18_19"
    back into a list of 4-tuples of integers.
    """
    tile_tuples = []
    tile_chunks = tile_string.strip().split()
    for chunk in tile_chunks:
        try:
            nums = list(map(int, chunk.split('_')))
            if len(nums) == 4:
                tile_tuples.append(tuple(nums))
            else:
                raise ValueError(f"Invalid tile format: {chunk}")
        except Exception as e:
            print(f"Error parsing tile string '{chunk}': {e}")
    return tile_tuples

def is_valid_tile_sequence(text, min_tiles=5, max_tiles=100):
        """
        Validates that a generated string represents a valid sequence of tiles.
        """
        tile_chunks = text.strip().split()
        if not (min_tiles <= len(tile_chunks) <= max_tiles):
            return False

        for chunk in tile_chunks:
            parts = chunk.split('_')
            if len(parts) != 4:
                return False
            if not all(part.isdigit() for part in parts):
                return False

        return True

def build_tile_tokenizer(X_0_top, vocab_size=10000, tokenizer_path="tile_tokenizer"):
    # 1. Extract all unique tile strings (split by spaces)
    tile_set = set()
    for text in X_0_top["text"]:
        tile_set.update(text.strip().split())

    # 2. Define special tokens
    special_tokens = ["<s>", "</s>", "<pad>"]

    # 3. Create vocabulary
    vocab = {token: idx for idx, token in enumerate(special_tokens + sorted(tile_set))}

    # 4. Build WordLevel model
    model = WordLevel(vocab=vocab, unk_token="<pad>")
    tokenizer = Tokenizer(model)
    tokenizer.pre_tokenizer = Whitespace()  # splits on spaces

    # 5. Wrap into PreTrainedTokenizerFast
    hf_tokenizer = PreTrainedTokenizerFast(
        tokenizer_object=tokenizer,
        bos_token="<s>",
        eos_token="</s>",
        pad_token="<pad>"
    )

    # 6. Save tokenizer
    os.makedirs(tokenizer_path, exist_ok=True)
    hf_tokenizer.save_pretrained(tokenizer_path)

    return hf_tokenizer

